# Copy this file to ".env" (same folder as server.js) and fill in real values.
# server.js loads .env automatically on startup — no extra install needed.
# NEVER commit the real .env file to git or share it in chat/screenshots.

# --- Google sign-in (Google Cloud Console → APIs & Services → Credentials) ---
GOOGLE_CLIENT_ID=980179808649-1sprluehcp4hsnn88oafimhbtl4jdvql.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=https://schooldata-hub.onrender.com/auth/google/callback

# --- Facebook sign-in (Meta for Developers → your app → Facebook Login → Settings) ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# --- SMS gateway (optional — leave blank to keep running in mock mode) ---
# SMS_PROVIDER=africastalking
# SMS_API_KEY=
# SMS_USERNAME=
# SMS_SENDER_ID=

# --- Paystack (Dashboard → Settings → API Keys & Webhooks) ---
# Get these from https://dashboard.paystack.co — use the TEST keys (sk_test_/pk_test_)
# until you're ready to go live, then swap to the LIVE keys (sk_live_/pk_live_).
PAYSTACK_SECRET_KEY=sk_test_742ed3994b8f3e01baa102642f37fe03562b8cbd
# Where Paystack sends the student back after paying. Must match a URL your
# server actually serves; leave blank locally and it defaults to
# http://localhost:3000/payments/callback.
PAYSTACK_CALLBACK_URL=https://schooldata-hub.onrender.com/payments/callback
#
# NOTE: this app only *collects* payments with the key above. Which bank
# account or mobile money number the money actually pays out to is set
# separately, once, in the Paystack Dashboard under
# Settings → Accounts → Payout Account — not here, and not in any code file.

# --- Server port (optional) ---
# PORT=3000
